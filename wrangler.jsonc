{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smilecroatia",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-29",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
